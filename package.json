{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "build": "cross-env NODE_ENV=production vite build && web-ext build -s dist/chrome -n chrome.zip",
    "dev:firefox": "cross-env NODE_ENV=development EXTENSION=firefox vite build --watch",
    "build:firefox": "cross-env NODE_ENV=production EXTENSION=firefox vite build && web-ext build -s dist/chrome -n chrome.zip",
    "start:chromium": "web-ext run -t chromium",
    "start:firefox": "web-ext run -t firefox-desktop",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "fmt": "oxfmt",
    "init:playwright": "playwright install chromium --with-deps",
    "test:playwright": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "axios": "1.20.0",
    "cn": "0.2.3",
    "es-toolkit": "1.52.0",
    "i18next": "26.4.1",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "rxjs": "7.8.2",
    "serialize-error": "13.0.1",
    "typed-webext": "0.7.21",
    "uuid": "14.0.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@babel/preset-env": "8.0.2",
    "@fontsource-variable/fira-code": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.2.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/webextension-polyfill": "0.12.6",
    "@vitejs/devtools": "0.6.3",
    "@vitejs/plugin-react": "6.1.1",
    "@ziloen/eslint-config": "0.1.86",
    "@ziloen/tailwind-config": "2.0.28",
    "babel-plugin-annotate-module-pure": "1.0.6",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "browserslist-to-esbuild": "2.1.1",
    "core-js": "3.50.0",
    "cross-env": "10.1.0",
    "eslint": "10.9.1",
    "oxfmt": "0.66.0",
    "playwright": "1.62.1",
    "postcss-preset-env": "11.5.1",
    "rolldown": "1.2.6",
    "rollup-plugin-copy": "3.5.0",
    "svgo": "4.1.0",
    "tailwindcss": "4.3.3",
    "ts-lib-enhance": "1.0.24",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "web-ext": "10.6.0"
  },
  "webExt": {
    "artifactsDir": "dist",
    "run": {
      "browserConsole": false,
      "target": [
        "firefox-desktop"
      ]
    },
    "build": {
      "overwriteDest": true,
      "filename": "extension.xpi"
    }
  },
  "overrides": {
    "eslint": "$eslint",
    "typescript": "$typescript",
    "@vitejs/devtools": "$@vitejs/devtools"
  }
}
